# --- Geral ---
HIGH_SECRET_KEY=troque-por-uma-string-aleatoria-longa
HIGH_SITE_NAME=High
HIGH_DATABASE_URL=sqlite:///./data/high.db
HIGH_DEBUG=false

# --- Armazenamento ---
# "telegram" (produção) ou "local" (desenvolvimento, grava em data/files)
HIGH_STORAGE_BACKEND=telegram
HIGH_TELEGRAM_BOT_TOKEN=123456:ABC...
# ID do canal/grupo privado onde o bot é admin (ex.: -1001234567890)
HIGH_TELEGRAM_CHAT_ID=-100...
# API oficial: limite de download de 20 MB por arquivo (getFile).
# Com um servidor local (github.com/tdlib/telegram-bot-api) o limite sobe para 2 GB.
HIGH_TELEGRAM_API_BASE=https://api.telegram.org
HIGH_MAX_UPLOAD_MB=20

# --- Regras de upload ---
# "2K" = lado maior >= 2560 e lado menor >= 1440 (vale para retrato e paisagem)
HIGH_MIN_LONG_SIDE=2560
HIGH_MIN_SHORT_SIDE=1440

# --- Cache local das imagens baixadas do Telegram ---
HIGH_CACHE_DIR=./data/cache
HIGH_CACHE_MAX_MB=2048
